ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# ── authentication (multi-user M2) ───────────────────────────────────────────
#
# CODEONBOARD_COOKIE_SECURE
#   Whether the session cookie carries `Secure`, which makes it https-only.
#   DEFAULTS TO ON, and that direction is deliberate: a missing flag in
#   production means a session cookie sent in clear, so a wrong default should
#   fail visibly on plain http rather than silently over the internet.
#   Set to 0 for local http development.
CODEONBOARD_COOKIE_SECURE=0
#
# CODEONBOARD_TRUST_PROXY
#   Honour `X-Forwarded-For` when deciding which IP to rate-limit. Leave unset
#   unless a reverse proxy actually sets it — a header the client controls is
#   otherwise a throttle bypass, since an attacker would simply vary it.
# CODEONBOARD_TRUST_PROXY=1

# ── Google sign-in (multi-user M6) ───────────────────────────────────────────
#
# Unset means the button is hidden and /auth/google/start answers 503 — the
# feature is absent rather than half-working.
#
# Redirect URI to register with Google, for local development:
#   http://localhost:8000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# CODEONBOARD_SECRET_KEY
#   Signs the short-lived cookie that carries `state` and `nonce` across the
#   Google redirect. Without it a per-process random value is used, so flows do
#   not survive a restart. REQUIRED in production — M8's startup check enforces
#   that; optional locally so a feature most runs never touch does not block
#   development.
# CODEONBOARD_SECRET_KEY=

# ── frontend ─────────────────────────────────────────────────────────────────
#
# API_ORIGIN (read by the Next.js SERVER, in frontend/next.config.ts)
#   Where /api/* is proxied to. Replaces NEXT_PUBLIC_API_URL, which was baked
#   into the browser bundle at build time — this one is read per request and
#   never reaches the client, so the API's address stops being public.
#   Defaults to http://localhost:8000.
# API_ORIGIN=http://localhost:8000

# ── production (multi-user M8) ───────────────────────────────────────────────
#
# CODEONBOARD_ENV=production makes the startup check REFUSE to serve on an
# insecure setting rather than warn about it: insecure cookies, a missing
# signing key, a leftover localhost origin, or half-configured Google. Every one
# of those works perfectly until it matters, which is exactly why a log line is
# not enough.
# CODEONBOARD_ENV=production
