.env
.DS_Store
.venv/
data/repos/
# The learner's WRITABLE working copy, which `Continue in Claude Code` opens and
# a coding agent edits. Deliberately NOT `data/repos/`: that is one shared,
# pinned checkout the grounding oracle resolves every anchor against, and an
# agent editing it would move the ground under every lesson in every session.
# Prepared per machine by `tools/prepare_workspace.py`; never committed.
/workspace/
data/*.db
# Hand-made copies of a database, kept beside it while something is being
# compared or rolled back — `sessions.db.post-f2`, `sessions.db.<date>-backup`.
# `data/*.db` does not match them, because the suffix comes AFTER the extension,
# and one of these is the whole development corpus under a different name.
data/sessions.db.*
# SQLite's WAL sidecars. The learning store runs in WAL mode, so these two sit
# beside every database file the app or the test suite touches — and `data/*.db`
# does not match them, because the suffix comes AFTER the extension.
data/*.db-wal
data/*.db-shm
# The rollback journal, for the fallback path where WAL is unavailable.
data/*.db-journal
__pycache__/
*.pyc
.pytest_cache/
.idea/
_tmp_compare/
frontend/.next/
frontend/.next-*/
frontend/node_modules/
node_modules/
data/quarantine/
# A throwaway copy of the frontend, used to view two builds side by side.
.ui-audit-fe/
# Scratch file written into the served directory while probing the UI.
frontend/public/probe.txt
