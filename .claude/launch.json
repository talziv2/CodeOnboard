{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "backend.api:app", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "backend-curriculum",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set \"CODEONBOARD_CURRICULUM=1\" && uv run python -m uvicorn backend.api:app --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    }
  ]
}
