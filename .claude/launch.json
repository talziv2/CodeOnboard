{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "backend-curriculum",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set \"CODEONBOARD_CURRICULUM=1\" && uv run python -m uvicorn backend.api:app --port 8000 --reload"
      ],
      "port": 8000
    },
    {
      "name": "backend-e2e",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend-3001",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8001",
        "--reload"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3001,http://127.0.0.1:3001"
      },
      "port": 8001
    },
    {
      "name": "frontend-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8001"
      },
      "cwd": "frontend",
      "port": 3001
    },
    {
      "name": "frontend-3100",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8000"
      },
      "cwd": "frontend",
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "frontend-uiaudit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3007"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8000"
      },
      "cwd": ".ui-audit-fe",
      "port": 3007
    },
    {
      "name": "backend-uiaudit",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8000"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3007,http://127.0.0.1:3007",
        "CODEONBOARD_GAPS": "1"
      },
      "port": 8000
    },
    {
      "name": "backend-3100",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8100",
        "--reload"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3100,http://127.0.0.1:3100"
      },
      "port": 8100
    },
    {
      "name": "backend-reload-8000",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8000",
        "--reload"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3100,http://127.0.0.1:3100"
      },
      "port": 8000
    },
    {
      "name": "frontend-3105",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3105"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8105"
      },
      "cwd": "frontend",
      "port": 3105
    },
    {
      "name": "backend-3105",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8105",
        "--reload"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3105,http://127.0.0.1:3105",
        "CODEONBOARD_GAPS": "1"
      },
      "port": 8105
    },
    {
      "name": "frontend-3105-isolated",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3105"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8000",
        "NEXT_DIST_DIR": ".next-3105"
      },
      "cwd": "frontend",
      "port": 3105
    },
    {
      "name": "backend-e2e-open",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "backend.api:app",
        "--port",
        "8000"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3105,http://127.0.0.1:3105",
        "CODEONBOARD_GAPS": "1"
      },
      "port": 8000
    },
    {
      "name": "frontend-3105-8105",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3105"
      ],
      "env": {
        "API_ORIGIN": "http://localhost:8105",
        "NEXT_DIST_DIR": ".next-3105"
      },
      "cwd": "frontend",
      "port": 3105,
      "autoPort": false
    },
    {
      "name": "backend-3107",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "uvicorn",
        "scripts.ux_fixture_app:app",
        "--port",
        "8107"
      ],
      "env": {
        "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3107,http://127.0.0.1:3107",
        "CODEONBOARD_GAPS": "1",
        "CODEONBOARD_CURRICULUM": "1",
        "CODEONBOARD_UX_DB": "data/ux-fixture.db"
      },
      "port": 8107,
      "autoPort": false
    },
    {
      "name": "frontend-3107",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3107"
      ],
      "env": {
        "API_ORIGIN": "http://localhost:8107",
        "NEXT_DIST_DIR": ".next-3107"
      },
      "cwd": "frontend",
      "port": 3107,
      "autoPort": false
    }
  ]
}
