{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "backend.api:app", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "backend-curriculum",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set \"CODEONBOARD_CURRICULUM=1\" && uv run python -m uvicorn backend.api:app --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "backend-3001",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "backend.api:app", "--port", "8001", "--reload"],
      "env": { "CODEONBOARD_ALLOWED_ORIGINS": "http://localhost:3001,http://127.0.0.1:3001" },
      "port": 8001
    },
    {
      "name": "frontend-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3001"],
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:8001" },
      "cwd": "frontend",
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    }
  ]
}
