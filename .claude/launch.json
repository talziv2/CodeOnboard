{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "backend.api:app", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "backend-curriculum",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-c", "import os; os.environ['CODEONBOARD_CURRICULUM'] = '1'; os.environ['CODEONBOARD_ALLOWED_ORIGINS'] = 'http://localhost:3000,http://localhost:3010'; import uvicorn; uvicorn.run('backend.api:app', port=8010)"],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "frontend-e2e-3010",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3010"],
      "cwd": "_tmp_compare/fe3010",
      "port": 3010
    }
  ]
}
